rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function accountPath(uid) {
      return /databases/$(database)/documents/accounts/$(uid);
    }

    function validMediaPath(path, uid) {
      // Один RE2 matcher с quoted UID: `path` читается один раз; non-string
      // вызывает evaluation error, то есть отказ.
      return path.matches('^(' + documentMediaPattern(uid) + ')?$');
    }

    function validProfile(profile, uid, version) {
      // Каждый обязательный field ниже читается и проверяется по типу;
      // повторный hasAll не нужен, missing/non-map остаётся fail-closed.
      return profile.keys().hasOnly(version >= 6
          ? ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl',
            'avatarPath', 'publishLocation']
          : version >= 3
          ? ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl',
            'avatarPath']
          : ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl'])
        && (profile.name + profile.username + profile.headline + profile.bio
          + profile.locationText + profile.avatarUrl) is string
        && (version < 3 || validMediaPath(profile.get('avatarPath', ''), uid))
        && (version < 6 || profile.get('publishLocation', false) is bool);
    }

    function validContentFields(content, uid, version) {
      // Rules не имеют циклов: элементы projects/imagePaths проверяет общий codec.
      return validProfile(content.profile, uid, version)
        && content.skills is list && content.projects is list
        && content.experience is list && content.education is list
        && content.links is list && content.blocks is list
        && content.resumeText is string && content.theme in ['dark', 'light'];
    }

    function validPublicContent(content) {
      return validContentFields(content, '', 0)
        && content.keys().hasOnly([
          'profile', 'skills', 'projects', 'experience', 'education', 'links',
          'blocks', 'resumeText', 'theme'
        ]);
    }

    function validPrivateContent(content, version, uid, deleted) {
      return version == 1 ? validPublicContent(content)
        : validContentFields(content, uid, version)
          && content.keys().hasOnly(version >= 7 ? [
            'profile', 'skills', 'projects', 'experience', 'education', 'links',
            'blocks', 'resumeText', 'theme', 'ignoredGitHubRepositories', 'documents',
            'mainPortfolioId', 'githubUsername', 'personalization', 'legacyMainSnapshot'
          ] : version >= 4 ? [
            'profile', 'skills', 'projects', 'experience', 'education', 'links',
            'blocks', 'resumeText', 'theme', 'ignoredGitHubRepositories', 'documents'
          ] : [
            'profile', 'skills', 'projects', 'experience', 'education', 'links',
            'blocks', 'resumeText', 'theme', 'ignoredGitHubRepositories'
          ])
          && content.get('ignoredGitHubRepositories', []) is list
          && (version < 4 || validDocumentPrivacy(content.get('documents', []), uid, version, content.get('mainPortfolioId', null), content.get('legacyMainSnapshot', null), deleted))
          && (version < 7 || validMainMetadata(content));
    }

    function validMainMetadata(content) {
      // `let` пересчитывается при каждом обращении: дефолт null вместо map
      // и объединённые проверки держат запас лимита выражений.
      let mainId = content.get('mainPortfolioId', null);
      let github = content.get('githubUsername', '');
      let progress = content.get('personalization', null);
      return (mainId == null || mainId.matches('^[^/]{1,200}$'))
        && github.size() <= 39
        && github.matches('^([a-z0-9]+(-[a-z0-9]+)*)?$')
        && (progress == null ? !('personalization' in content)
          : (progress.keys().hasOnly(['status', 'step'])
            && progress.status in ['notRequired', 'inProgress', 'completed']
            && progress.step is int && progress.step in [0, 1, 2, 3]))
        && content.get('legacyMainSnapshot', {}) is map;
    }

    function validDocumentPrivacy(documents, uid, version, mainId, legacySnapshot, deleted) {
      // Для пустого списка нет indexed paths/tombstones: остаётся только архив.
      return documents is list && (documents.size() == 0
        ? mainId == null && (legacySnapshot == null
          || (validMediaPath(legacySnapshot.content.profile.avatarPath, uid)
            && (!legacySnapshot.keys().hasAny(['baseSnapshot'])
              || validMediaPath(legacySnapshot.baseSnapshot.profile.avatarPath, uid))))
        : validReviewedDocuments(documents, uid, version, mainId, legacySnapshot, deleted));
    }

    function validReviewedDocuments(documents, uid, version, mainId, legacySnapshot, deleted) {
      // Функция на каждый размер списка: `let` в Rules пересчитывается при каждом
      // обращении, а прежний padding до21 пересобирал concat на каждый индекс и
      // упирался в лимит1000 выражений. Все исходные records проверяются явно.
      return documents.size() <= (version >= 7 ? 21 : 20)
        && validDocumentsOfSize(documents, documentMediaPattern(uid), mainId,
          legacySnapshot == null ? documents[0] : legacySnapshot, deleted);
    }

    function documentMediaPattern(uid) {
      let escapedUid = uid.replace('\\\\E', '\\\\E\\\\\\\\E\\\\Q');
      return 'accounts/\\Q' + escapedUid + '\\E/media/[0-9a-f]{32}[.]jpg';
    }

    function validDocumentsOfSize(documents, media, mainId, archive, deleted) {
      // Самые дорогие размеры20/21 выбираются первыми, остальные — бинарно.
      return documents.size() >= 20
        ? (documents.size() == 21 ? validDocuments21(documents, media, mainId, archive, deleted)
          : validDocuments20(documents, media, mainId, archive, deleted))
        : (documents.size() <= 10 ? (documents.size() <= 5 ? (documents.size() <= 3 ? (documents.size() <= 2 ? (documents.size() <= 1 ? validDocuments1(documents, media, mainId, archive, deleted) : validDocuments2(documents, media, mainId, archive, deleted)) : validDocuments3(documents, media, mainId, archive, deleted)) : (documents.size() <= 4 ? validDocuments4(documents, media, mainId, archive, deleted) : validDocuments5(documents, media, mainId, archive, deleted))) : (documents.size() <= 8 ? (documents.size() <= 7 ? (documents.size() <= 6 ? validDocuments6(documents, media, mainId, archive, deleted) : validDocuments7(documents, media, mainId, archive, deleted)) : validDocuments8(documents, media, mainId, archive, deleted)) : (documents.size() <= 9 ? validDocuments9(documents, media, mainId, archive, deleted) : validDocuments10(documents, media, mainId, archive, deleted)))) : (documents.size() <= 15 ? (documents.size() <= 13 ? (documents.size() <= 12 ? (documents.size() <= 11 ? validDocuments11(documents, media, mainId, archive, deleted) : validDocuments12(documents, media, mainId, archive, deleted)) : validDocuments13(documents, media, mainId, archive, deleted)) : (documents.size() <= 14 ? validDocuments14(documents, media, mainId, archive, deleted) : validDocuments15(documents, media, mainId, archive, deleted))) : (documents.size() <= 17 ? (documents.size() <= 16 ? validDocuments16(documents, media, mainId, archive, deleted) : validDocuments17(documents, media, mainId, archive, deleted)) : (documents.size() <= 18 ? validDocuments18(documents, media, mainId, archive, deleted) : validDocuments19(documents, media, mainId, archive, deleted)))));
    }

    function validDocuments1(documents, media, mainId, archive, deleted) {
      // Фиксированные 4 разделителя отклоняют null, non-string и injected ';'.
      let emptyContent = {'profile': {'avatarPath': ''}};
      let ids = [documents[0].id];
      let paths = [documents[0].content.profile.avatarPath, documents[0].get('baseSnapshot', emptyContent).profile.avatarPath,
        archive.content.profile.avatarPath, archive.get('baseSnapshot', emptyContent).profile.avatarPath,
        ''].join(';');
      return !ids.hasAny(deleted)
        && (mainId == null || mainId in ids)
        && paths.matches('^((' + media + ')?;){4}$');
    }

    function validDocuments2(documents, media, mainId, archive, deleted) {
      // Фиксированные 6 разделителя отклоняют null, non-string и injected ';'.
      let emptyContent = {'profile': {'avatarPath': ''}};
      let ids = [documents[0].id, documents[1].id];
      let paths = [documents[0].content.profile.avatarPath, documents[0].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[1].content.profile.avatarPath, documents[1].get('baseSnapshot', emptyContent).profile.avatarPath,
        archive.content.profile.avatarPath, archive.get('baseSnapshot', emptyContent).profile.avatarPath,
        ''].join(';');
      return !ids.hasAny(deleted)
        && (mainId == null || mainId in ids)
        && paths.matches('^((' + media + ')?;){6}$');
    }

    function validDocuments3(documents, media, mainId, archive, deleted) {
      // Фиксированные 8 разделителя отклоняют null, non-string и injected ';'.
      let emptyContent = {'profile': {'avatarPath': ''}};
      let ids = [documents[0].id, documents[1].id, documents[2].id];
      let paths = [documents[0].content.profile.avatarPath, documents[0].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[1].content.profile.avatarPath, documents[1].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[2].content.profile.avatarPath, documents[2].get('baseSnapshot', emptyContent).profile.avatarPath,
        archive.content.profile.avatarPath, archive.get('baseSnapshot', emptyContent).profile.avatarPath,
        ''].join(';');
      return !ids.hasAny(deleted)
        && (mainId == null || mainId in ids)
        && paths.matches('^((' + media + ')?;){8}$');
    }

    function validDocuments4(documents, media, mainId, archive, deleted) {
      // Фиксированные 10 разделителя отклоняют null, non-string и injected ';'.
      let emptyContent = {'profile': {'avatarPath': ''}};
      let ids = [documents[0].id, documents[1].id, documents[2].id, documents[3].id];
      let paths = [documents[0].content.profile.avatarPath, documents[0].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[1].content.profile.avatarPath, documents[1].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[2].content.profile.avatarPath, documents[2].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[3].content.profile.avatarPath, documents[3].get('baseSnapshot', emptyContent).profile.avatarPath,
        archive.content.profile.avatarPath, archive.get('baseSnapshot', emptyContent).profile.avatarPath,
        ''].join(';');
      return !ids.hasAny(deleted)
