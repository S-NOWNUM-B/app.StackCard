rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function accountPath(uid) {
      return /databases/$(database)/documents/accounts/$(uid);
    }

    function validMediaPath(path, uid) {
      return path is string && (path == ''
        || (path.matches('^accounts/[^/]+/media/[0-9a-f]{32}[.]jpg$')
          && path.split('/')[1] == uid));
    }

    function validProfile(profile, uid, version) {
      // Каждый обязательный field ниже читается и проверяется по типу;
      // повторный hasAll не нужен, missing/non-map остаётся fail-closed.
      return profile.keys().hasOnly(version >= 6
          ? ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl',
            'avatarPath', 'publishLocation']
          : version >= 3
          ? ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl',
            'avatarPath']
          : ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl'])
        && profile.name is string && profile.username is string
        && profile.headline is string && profile.bio is string
        && profile.locationText is string && profile.avatarUrl is string
        && (version < 3 || validMediaPath(profile.get('avatarPath', ''), uid))
        && (version < 6 || profile.get('publishLocation', false) is bool);
    }

    function validContentFields(content, uid, version) {
      // Rules не имеют циклов: элементы projects/imagePaths проверяет общий codec.
      return validProfile(content.profile, uid, version)
        && content.skills is list && content.projects is list
        && content.experience is list && content.education is list
        && content.links is list && content.blocks is list
        && content.resumeText is string && content.theme in ['dark', 'light'];
    }

    function validPublicContent(content) {
      return validContentFields(content, '', 0)
        && content.keys().hasOnly([
          'profile', 'skills', 'projects', 'experience', 'education', 'links',
          'blocks', 'resumeText', 'theme'
        ]);
    }

    function validPrivateContent(content, version, uid) {
      return version == 1 ? validPublicContent(content)
        : validContentFields(content, uid, version)
          && content.keys().hasOnly(version >= 4 ? [
            'profile', 'skills', 'projects', 'experience', 'education', 'links',
            'blocks', 'resumeText', 'theme', 'ignoredGitHubRepositories', 'documents'
          ] : [
            'profile', 'skills', 'projects', 'experience', 'education', 'links',
            'blocks', 'resumeText', 'theme', 'ignoredGitHubRepositories'
          ])
          && content.get('ignoredGitHubRepositories', []) is list
          && (version < 4 || validReviewedDocuments(content.get('documents', []), uid));
    }

    function validReviewedDocuments(documents, uid) {
      // Padding убирает 20 условных ветвей и сохраняет бюджет Rules <= 1000.
      // Фиксированные 40 разделителей отклоняют null, non-string и injected ';'.
      let empty = {'id': null, 'content': {'profile': {'avatarPath': ''}}};
      let padded = documents.concat([empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty]);
      let escapedUid = uid.replace('\\\\E', '\\\\E\\\\\\\\E\\\\Q');
      let media = 'accounts/\\Q' + escapedUid + '\\E/media/[0-9a-f]{32}[.]jpg';
      let deleted = exists(accountPath(uid)) ? get(accountPath(uid)).data.get('deletedDocumentIds', []) : [];
      let ids = [padded[0].id,
        padded[1].id,
        padded[2].id,
        padded[3].id,
        padded[4].id,
        padded[5].id,
        padded[6].id,
        padded[7].id,
        padded[8].id,
        padded[9].id,
        padded[10].id,
        padded[11].id,
        padded[12].id,
        padded[13].id,
        padded[14].id,
        padded[15].id,
        padded[16].id,
        padded[17].id,
        padded[18].id,
        padded[19].id];
      let paths = [padded[0].content.profile.avatarPath, padded[0].get('baseSnapshot', padded[0].content).profile.avatarPath,
        padded[1].content.profile.avatarPath, padded[1].get('baseSnapshot', padded[1].content).profile.avatarPath,
        padded[2].content.profile.avatarPath, padded[2].get('baseSnapshot', padded[2].content).profile.avatarPath,
        padded[3].content.profile.avatarPath, padded[3].get('baseSnapshot', padded[3].content).profile.avatarPath,
        padded[4].content.profile.avatarPath, padded[4].get('baseSnapshot', padded[4].content).profile.avatarPath,
        padded[5].content.profile.avatarPath, padded[5].get('baseSnapshot', padded[5].content).profile.avatarPath,
        padded[6].content.profile.avatarPath, padded[6].get('baseSnapshot', padded[6].content).profile.avatarPath,
        padded[7].content.profile.avatarPath, padded[7].get('baseSnapshot', padded[7].content).profile.avatarPath,
        padded[8].content.profile.avatarPath, padded[8].get('baseSnapshot', padded[8].content).profile.avatarPath,
        padded[9].content.profile.avatarPath, padded[9].get('baseSnapshot', padded[9].content).profile.avatarPath,
        padded[10].content.profile.avatarPath, padded[10].get('baseSnapshot', padded[10].content).profile.avatarPath,
        padded[11].content.profile.avatarPath, padded[11].get('baseSnapshot', padded[11].content).profile.avatarPath,
        padded[12].content.profile.avatarPath, padded[12].get('baseSnapshot', padded[12].content).profile.avatarPath,
        padded[13].content.profile.avatarPath, padded[13].get('baseSnapshot', padded[13].content).profile.avatarPath,
        padded[14].content.profile.avatarPath, padded[14].get('baseSnapshot', padded[14].content).profile.avatarPath,
        padded[15].content.profile.avatarPath, padded[15].get('baseSnapshot', padded[15].content).profile.avatarPath,
        padded[16].content.profile.avatarPath, padded[16].get('baseSnapshot', padded[16].content).profile.avatarPath,
        padded[17].content.profile.avatarPath, padded[17].get('baseSnapshot', padded[17].content).profile.avatarPath,
        padded[18].content.profile.avatarPath, padded[18].get('baseSnapshot', padded[18].content).profile.avatarPath,
        padded[19].content.profile.avatarPath, padded[19].get('baseSnapshot', padded[19].content).profile.avatarPath,
        ''].join(';');
      return documents is list && documents.size() <= 20 && !ids.hasAny(deleted)
        && paths.matches('^((' + media + ')?;){40}$');
    }

    function activeAccount(uid) {
      return !exists(accountPath(uid))
        || get(accountPath(uid)).data.get('lifecycleState', 'active') == 'active';
    }

    function legacyAccount(uid) {
      return !exists(accountPath(uid))
        || !get(accountPath(uid)).data.keys().hasAny(['lifecycleGeneration']);
    }

    match /accounts/{uid} {
      allow get: if owner(uid);
      // Публикация/lock/tombstones принадлежат authenticated trusted service.
      allow list, write: if false;

      match /drafts/{draftId} {
        allow get: if draftId == 'current' && owner(uid);
        allow delete: if draftId == 'current' && owner(uid)
          && activeAccount(uid) && legacyAccount(uid);
        allow list: if false;
        allow create, update: if draftId == 'current' && owner(uid)
          && activeAccount(uid)
          && (!exists(/databases/$(database)/documents/accounts/$(uid)/drafts/$(draftId))
            || (resource.data.schemaVersion is int
              && resource.data.schemaVersion in [1, 2, 3, 4, 5, 6]
              && resource.data.ownerUid == uid
              && resource.data.schemaVersion <= request.resource.data.schemaVersion))
          // Обязательные 7 полей ниже читаются и проверяются по типу; extra запрещены.
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'ownerUid', 'mutationId', 'localRevision',
            'notes', 'content', 'updatedAt'
          ])
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion in [1, 2, 3, 4, 5, 6]
          && request.resource.data.ownerUid == uid
          && request.resource.data.mutationId is string
          && request.resource.data.mutationId.size() > 0
          && request.resource.data.localRevision is int
          && request.resource.data.localRevision >= 1
          && request.resource.data.notes is string
          && (request.resource.data.content == null
            || validPrivateContent(request.resource.data.content,
              request.resource.data.schemaVersion, uid))
          && request.resource.data.updatedAt == request.time;
      }

      match /publications/{documentId} {
        allow get, list: if owner(uid);
        allow write: if false;
      }

      match /publicationOperations/{operationId} {
        allow get: if owner(uid);
        allow list, write: if false;
      }
    }

    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    match /publicPortfolios/{username} {
      // Исторический snapshot доступен без миграции/перенаправления username.
      allow get: if true;
      allow list, write: if false;
    }

    match /publicDocuments/{publicId} {
      // Handler Admin SDK — единственный writer; public не содержит owner fields.
      allow get: if publicId.matches('^[0-9a-f]{32}$');
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
