    function validDraftWrite(uid) {
      let draft = request.resource.data;
      let account = exists(accountPath(uid)) ? get(accountPath(uid)).data : {};
      // Обязательные 7 полей ниже читаются и проверяются по типу; extra запрещены.
      return account.get('lifecycleState', 'active') == 'active'
        && draft.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'mutationId', 'localRevision',
          'notes', 'content', 'updatedAt'
          ])
        && draft.schemaVersion is int
        && draft.schemaVersion in [1, 2, 3, 4, 5, 6, 7]
        && draft.ownerUid == uid
        && draft.mutationId is string
        && draft.mutationId.size() > 0
        && draft.localRevision is int
        && draft.localRevision >= 1
        && draft.notes is string
        && (draft.content == null
          || validPrivateContent(draft.content,
            draft.schemaVersion, uid, account.get('deletedDocumentIds', [])))
        && draft.updatedAt == request.time;
    }

    function activeAccount(uid) {
      return !exists(accountPath(uid))
        || get(accountPath(uid)).data.get('lifecycleState', 'active') == 'active';
    }

    function legacyAccount(uid) {
      return !exists(accountPath(uid))
        || !get(accountPath(uid)).data.keys().hasAny(['lifecycleGeneration']);
    }

    function validContactRequest(data, requestId) {
      return data.keys().hasOnly(['schemaVersion', 'requestId', 'publicId',
          'documentId', 'documentTitle', 'name', 'email', 'message', 'createdAt', 'readAt'])
        && data.schemaVersion == 1 && data.requestId == requestId
        && requestId.matches('^[0-9a-f]{32}$')
        && data.publicId is string && data.publicId.matches('^[0-9a-f]{32}$')
        && data.documentId is string && data.documentId.size() > 0 && data.documentId.size() <= 200
        && data.documentTitle is string && data.documentTitle.size() > 0 && data.documentTitle.size() <= 120
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && data.message is string && data.message.size() > 0 && data.message.size() <= 4000
        && data.createdAt is timestamp && (data.readAt == null || data.readAt is timestamp);
    }

    match /accounts/{uid} {
      allow get: if owner(uid);
      // Публикация/lock/tombstones принадлежат authenticated trusted service.
      allow list, write: if false;

      match /drafts/{draftId} {
        allow get: if draftId == 'current' && owner(uid);
        allow delete: if draftId == 'current' && owner(uid)
          && activeAccount(uid) && legacyAccount(uid);
        allow list: if false;
        allow create, update: if draftId == 'current' && owner(uid)
          && (resource == null
            || (resource.data.schemaVersion is int
              && resource.data.schemaVersion in [1, 2, 3, 4, 5, 6, 7]
              && resource.data.ownerUid == uid
              && resource.data.schemaVersion <= request.resource.data.schemaVersion))
          && validDraftWrite(uid);
      }

      match /media/{mediaId} {
        // Spark avatar store; ID immutable, никогда не публикуется чтением владельца.
        allow get, delete: if owner(uid) && activeAccount(uid)
          && mediaId.matches('^[0-9a-f]{32}[.]jpg$');
        allow list, update: if false;
        allow create: if owner(uid) && activeAccount(uid)
          && mediaId.matches('^[0-9a-f]{32}[.]jpg$')
          && request.resource.data.keys().hasOnly(['schemaVersion', 'contentType', 'base64'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.contentType == 'image/jpeg'
          && request.resource.data.base64 is string
          && request.resource.data.base64.size() > 0 && request.resource.data.base64.size() <= 349528
          && request.resource.data.base64.matches('^/9j/[A-Za-z0-9+/]*={0,2}$');
      }

      match /publications/{documentId} {
        allow get, list: if owner(uid);
        allow write: if false;
      }

      match /publicationOperations/{operationId} {
        allow get: if owner(uid);
        allow list, write: if false;
      }

      match /contactRequests/{requestId} {
        allow get: if owner(uid) && activeAccount(uid);
        allow list: if owner(uid) && activeAccount(uid)
          && request.query.limit is int && request.query.limit > 0 && request.query.limit <= 50;
        allow update: if owner(uid) && activeAccount(uid)
          && validContactRequest(request.resource.data, requestId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow create, delete: if false;
      }
    }

    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    match /publicPortfolios/{username} {
      // Исторический snapshot доступен без миграции/перенаправления username.
      allow get: if true;
      allow list, write: if false;
    }

    match /publicDocuments/{publicId} {
      // Handler Admin SDK — единственный writer; public не содержит owner fields.
      allow get: if publicId.matches('^[0-9a-f]{32}$');
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
