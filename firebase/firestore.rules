        documents[3].content.profile.avatarPath, documents[3].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[4].content.profile.avatarPath, documents[4].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[5].content.profile.avatarPath, documents[5].get('baseSnapshot', emptyContent).profile.avatarPath,
        documents[6].content.profile.avatarPath, documents[6].get('baseSnapshot', emptyContent).profile.avatarPath,
        archive.content.profile.avatarPath, archive.get('baseSnapshot', emptyContent).profile.avatarPath,
        ''].join(';');
      return !ids.hasAny(deleted)
        && (mainId == null || mainId in ids)
        && paths.matches('^((' + media + ')?;){16}$');
    }

    function validDocuments8(documents, media, mainId, archive, deleted) {
