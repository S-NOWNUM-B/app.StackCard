rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function accountPath(uid) {
      return /databases/$(database)/documents/accounts/$(uid);
    }

    function validMediaPath(path, uid) {
      return path is string && (path == ''
        || (path.matches('^accounts/[^/]+/media/[0-9a-f]{32}[.]jpg$')
          && path.split('/')[1] == uid));
    }

    function validProfile(profile, uid, version) {
      // Каждый обязательный field ниже читается и проверяется по типу;
      // повторный hasAll не нужен, missing/non-map остаётся fail-closed.
      return profile.keys().hasOnly(version >= 6
          ? ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl',
            'avatarPath', 'publishLocation']
          : version >= 3
          ? ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl',
            'avatarPath']
          : ['name', 'username', 'headline', 'bio', 'locationText', 'avatarUrl'])
        && (profile.name + profile.username + profile.headline + profile.bio
          + profile.locationText + profile.avatarUrl) is string
        && (version < 3 || validMediaPath(profile.get('avatarPath', ''), uid))
        && (version < 6 || profile.get('publishLocation', false) is bool);
    }

    function validContentFields(content, uid, version) {
      // Rules не имеют циклов: элементы projects/imagePaths проверяет общий codec.
      return validProfile(content.profile, uid, version)
        && content.skills is list && content.projects is list
        && content.experience is list && content.education is list
        && content.links is list && content.blocks is list
        && content.resumeText is string && content.theme in ['dark', 'light'];
    }

    function validPublicContent(content) {
      return validContentFields(content, '', 0)
        && content.keys().hasOnly([
          'profile', 'skills', 'projects', 'experience', 'education', 'links',
          'blocks', 'resumeText', 'theme'
        ]);
    }

    function validPrivateContent(content, version, uid, deleted) {
      return version == 1 ? validPublicContent(content)
        : validContentFields(content, uid, version)
          && content.keys().hasOnly(version >= 7 ? [
            'profile', 'skills', 'projects', 'experience', 'education', 'links',
            'blocks', 'resumeText', 'theme', 'ignoredGitHubRepositories', 'documents',
            'mainPortfolioId', 'githubUsername', 'personalization', 'legacyMainSnapshot'
          ] : version >= 4 ? [
            'profile', 'skills', 'projects', 'experience', 'education', 'links',
            'blocks', 'resumeText', 'theme', 'ignoredGitHubRepositories', 'documents'
          ] : [
            'profile', 'skills', 'projects', 'experience', 'education', 'links',
            'blocks', 'resumeText', 'theme', 'ignoredGitHubRepositories'
          ])
          && content.get('ignoredGitHubRepositories', []) is list
          && (version < 4 || validDocumentPrivacy(content.get('documents', []), uid, version, content.get('mainPortfolioId', null), content.get('legacyMainSnapshot', null), deleted))
          && (version < 7 || validMainMetadata(content));
    }

    function validMainMetadata(content) {
      let mainId = content.get('mainPortfolioId', null);
      let github = content.get('githubUsername', '');
      let progress = content.get('personalization', {'status': 'notRequired', 'step': 0});
      return (mainId == null || mainId.matches('^[^/]{1,200}$'))
        && github.size() <= 39
        && (github == '' || github.matches('^[a-z0-9]+(-[a-z0-9]+)*$'))
        && progress.keys().hasOnly(['status', 'step'])
        && progress.status in ['notRequired', 'inProgress', 'completed']
        && progress.step is int && progress.step >= 0 && progress.step <= 3
        && content.get('legacyMainSnapshot', {}) is map;
    }

    function validDocumentPrivacy(documents, uid, version, mainId, legacySnapshot, deleted) {
      // Для пустого списка нет indexed paths/tombstones: остаётся только архив.
      return documents is list && (documents.size() == 0
        ? mainId == null && (legacySnapshot == null
          || (validMediaPath(legacySnapshot.content.profile.avatarPath, uid)
            && (!legacySnapshot.keys().hasAny(['baseSnapshot'])
              || validMediaPath(legacySnapshot.baseSnapshot.profile.avatarPath, uid))))
        : validReviewedDocuments(documents, uid, version, mainId, legacySnapshot, deleted));
    }

    function validReviewedDocuments(documents, uid, version, mainId, legacySnapshot, deleted) {
      // Padding использует ссылки первого record;
      // все исходные records остаются среди первых21 и не меняются.
      // Фиксированные 44 разделителя отклоняют null, non-string и injected ';'.
      let emptyContent = {'profile': {'avatarPath': ''}};
      let empty = documents[0];
      let padded = documents.size() == 21 ? documents : documents.concat([empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty, empty]);
      let archive = legacySnapshot == null ? empty : legacySnapshot;
      let escapedUid = uid.replace('\\\\E', '\\\\E\\\\\\\\E\\\\Q');
      let media = 'accounts/\\Q' + escapedUid + '\\E/media/[0-9a-f]{32}[.]jpg';
      let ids = [padded[0].id,
        padded[1].id,
        padded[2].id,
        padded[3].id,
        padded[4].id,
        padded[5].id,
        padded[6].id,
        padded[7].id,
        padded[8].id,
        padded[9].id,
        padded[10].id,
        padded[11].id,
        padded[12].id,
        padded[13].id,
        padded[14].id,
        padded[15].id,
        padded[16].id,
        padded[17].id,
        padded[18].id,
        padded[19].id,
        padded[20].id];
      let paths = [padded[0].content.profile.avatarPath, padded[0].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[1].content.profile.avatarPath, padded[1].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[2].content.profile.avatarPath, padded[2].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[3].content.profile.avatarPath, padded[3].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[4].content.profile.avatarPath, padded[4].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[5].content.profile.avatarPath, padded[5].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[6].content.profile.avatarPath, padded[6].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[7].content.profile.avatarPath, padded[7].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[8].content.profile.avatarPath, padded[8].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[9].content.profile.avatarPath, padded[9].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[10].content.profile.avatarPath, padded[10].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[11].content.profile.avatarPath, padded[11].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[12].content.profile.avatarPath, padded[12].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[13].content.profile.avatarPath, padded[13].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[14].content.profile.avatarPath, padded[14].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[15].content.profile.avatarPath, padded[15].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[16].content.profile.avatarPath, padded[16].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[17].content.profile.avatarPath, padded[17].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[18].content.profile.avatarPath, padded[18].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[19].content.profile.avatarPath, padded[19].get('baseSnapshot', emptyContent).profile.avatarPath,
        padded[20].content.profile.avatarPath, padded[20].get('baseSnapshot', emptyContent).profile.avatarPath,
        archive.content.profile.avatarPath, archive.get('baseSnapshot', emptyContent).profile.avatarPath,
        ''].join(';');
      return documents is list && documents.size() <= (version >= 7 ? 21 : 20) && !ids.hasAny(deleted)
        && (mainId == null || mainId in ids)
        && paths.matches('^((' + media + ')?;){44}$');
    }

    function validDraftWrite(uid) {
      let draft = request.resource.data;
      let account = exists(accountPath(uid)) ? get(accountPath(uid)).data : {};
      // Обязательные 7 полей ниже читаются и проверяются по типу; extra запрещены.
      return account.get('lifecycleState', 'active') == 'active'
        && draft.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'mutationId', 'localRevision',
          'notes', 'content', 'updatedAt'
          ])
        && draft.schemaVersion is int
        && draft.schemaVersion in [1, 2, 3, 4, 5, 6, 7]
        && draft.ownerUid == uid
        && draft.mutationId is string
        && draft.mutationId.size() > 0
        && draft.localRevision is int
        && draft.localRevision >= 1
        && draft.notes is string
        && (draft.content == null
          || validPrivateContent(draft.content,
            draft.schemaVersion, uid, account.get('deletedDocumentIds', [])))
        && draft.updatedAt == request.time;
    }

    function activeAccount(uid) {
      return !exists(accountPath(uid))
        || get(accountPath(uid)).data.get('lifecycleState', 'active') == 'active';
    }

    function legacyAccount(uid) {
      return !exists(accountPath(uid))
        || !get(accountPath(uid)).data.keys().hasAny(['lifecycleGeneration']);
    }

    function validContactRequest(data, requestId) {
      return data.keys().hasOnly(['schemaVersion', 'requestId', 'publicId',
          'documentId', 'documentTitle', 'name', 'email', 'message', 'createdAt', 'readAt'])
        && data.schemaVersion == 1 && data.requestId == requestId
        && requestId.matches('^[0-9a-f]{32}$')
        && data.publicId is string && data.publicId.matches('^[0-9a-f]{32}$')
        && data.documentId is string && data.documentId.size() > 0 && data.documentId.size() <= 200
        && data.documentTitle is string && data.documentTitle.size() > 0 && data.documentTitle.size() <= 120
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && data.message is string && data.message.size() > 0 && data.message.size() <= 4000
        && data.createdAt is timestamp && (data.readAt == null || data.readAt is timestamp);
    }

    match /accounts/{uid} {
      allow get: if owner(uid);
      // Публикация/lock/tombstones принадлежат authenticated trusted service.
      allow list, write: if false;

      match /drafts/{draftId} {
        allow get: if draftId == 'current' && owner(uid);
        allow delete: if draftId == 'current' && owner(uid)
          && activeAccount(uid) && legacyAccount(uid);
        allow list: if false;
        allow create, update: if draftId == 'current' && owner(uid)
          && (!exists(/databases/$(database)/documents/accounts/$(uid)/drafts/$(draftId))
            || (resource.data.schemaVersion is int
              && resource.data.schemaVersion in [1, 2, 3, 4, 5, 6, 7]
              && resource.data.ownerUid == uid
              && resource.data.schemaVersion <= request.resource.data.schemaVersion))
          && validDraftWrite(uid);
      }

      match /media/{mediaId} {
        // Spark avatar store; ID immutable, никогда не публикуется чтением владельца.
        allow get, delete: if owner(uid) && activeAccount(uid)
          && mediaId.matches('^[0-9a-f]{32}[.]jpg$');
        allow list, update: if false;
        allow create: if owner(uid) && activeAccount(uid)
          && mediaId.matches('^[0-9a-f]{32}[.]jpg$')
          && request.resource.data.keys().hasOnly(['schemaVersion', 'contentType', 'base64'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.contentType == 'image/jpeg'
          && request.resource.data.base64 is string
          && request.resource.data.base64.size() > 0 && request.resource.data.base64.size() <= 349528
          && request.resource.data.base64.matches('^/9j/[A-Za-z0-9+/]*={0,2}$');
      }

      match /publications/{documentId} {
        allow get, list: if owner(uid);
        allow write: if false;
      }

      match /publicationOperations/{operationId} {
        allow get: if owner(uid);
        allow list, write: if false;
      }

      match /contactRequests/{requestId} {
        allow get: if owner(uid) && activeAccount(uid);
        allow list: if owner(uid) && activeAccount(uid)
          && request.query.limit is int && request.query.limit > 0 && request.query.limit <= 50;
        allow update: if owner(uid) && activeAccount(uid)
          && validContactRequest(request.resource.data, requestId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow create, delete: if false;
      }
    }

    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    match /publicPortfolios/{username} {
      // Исторический snapshot доступен без миграции/перенаправления username.
      allow get: if true;
      allow list, write: if false;
    }

    match /publicDocuments/{publicId} {
      // Handler Admin SDK — единственный writer; public не содержит owner fields.
      allow get: if publicId.matches('^[0-9a-f]{32}$');
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
