# Backend сохранён для будущего бесплатного подключения; постоянный hosting пока отложен.
# Требуются Node.js из package.json, HTTPS reverse proxy/hosting для Node API и Next.js,
# deployed Firestore Rules/indexes, Auth, FCM и App Check web provider того же проекта.
# Запуск после заполнения private .env.local: node --env-file=.env.local src/server.mjs
# Firebase остаётся Spark: не подключать billing/Blaze/Cloud Functions/App Hosting/TTL.
# Runtime principal ADC должен иметь Auth/Firestore/FCM permissions и бесплатное
# roles/firebaseappcheck.tokenVerifier для consume:true; обычная owner role его не заменяет.
# Не копируй credentials/HMAC в web env, mobile defines, Git или logs.
# Настоящий origin публичного Next.js reader; без него Publish запрещён.
PUBLIC_WEB_ORIGIN=
# Intended registered web app ID, совпадающий с NEXT_PUBLIC_FIREBASE_APP_ID.
# App Check: reCAPTCHA Enterprise SCORE key с точным hostname сайта (Essentials без billing).
CONTACT_APP_CHECK_APP_ID=
# Node self-host: actual Firebase project и loopback API port.
GCLOUD_PROJECT=
BACKEND_PORT=5001
# Node self-host читает HMAC ≥32 символов из private окружения, не из repo.
# Прежний Firebase Functions wrapper с defineSecret предназначен только для demo emulators.
CONTACT_RATE_HMAC_KEY=
# Node self-host использует Firebase Admin applicationDefault(). Укажи private ADC JSON path
# только в локальном окружении; также допустимы уже настроенные стандартные ADC.
GOOGLE_APPLICATION_CREDENTIALS=
# Live Spark: оставить пустым, Storage требует Blaze. Без bucket доступен text-only Publish.
# Bucket разрешён лишь для demo-* проекта с Auth/Firestore/Storage на loopback emulators.
PUBLIC_STORAGE_BUCKET=
# Demo bypass допускается лишь при FUNCTIONS_EMULATOR=true, demo-* project и actual
# FIREBASE_AUTH_EMULATOR_HOST/FIRESTORE_EMULATOR_HOST в формате loopback:port.
# FUNCTIONS_EMULATOR=false
# FIREBASE_AUTH_EMULATOR_HOST=
# FIRESTORE_EMULATOR_HOST=
# FIREBASE_STORAGE_EMULATOR_HOST=
