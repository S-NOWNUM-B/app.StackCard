{
  "name": "stackcard-firestore-rules",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:publication": "pnpm --dir functions test",
    "test:service": "firebase emulators:exec --only auth,firestore,storage --project demo-stackcard-test 'node --test test/publication_service.test.mjs'",
    "test:contact": "firebase emulators:exec --only auth,firestore --project demo-stackcard-test 'node --test test/contact_service.test.mjs'",
    "check:functions": "pnpm --dir functions run check",
    "test:firestore": "node --test test/firestore_rules.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-stackcard-test 'pnpm run test:firestore'",
    "test:storage": "firebase emulators:exec --only firestore,storage --project demo-stackcard-test 'node --test test/storage_rules.test.mjs'",
    "test:all-rules": "firebase emulators:exec --only auth,firestore,storage --project demo-stackcard-test 'pnpm test'"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.5.1"
  }
}
