# Contact/Inbox/FCM сохранены для будущего подключения; постоянный hosting пока отложен.
# Оставь API URLs и App Check key пустыми до настройки сервера: форма покажет unavailable.
# Полная инструкция: apps/web/README.md, раздел «Бесплатное окружение Spark».
# Публичная Firebase web app config того же проекта, что и mobile. Секретов здесь нет.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# HTTPS Node API /documentPublication; тот же проект и PUBLIC_WEB_ORIGIN backend.
NEXT_PUBLIC_PUBLICATION_API_URL=
# HTTPS Node API /contactInbox того же проекта. Live Cloud Functions не использовать.
NEXT_PUBLIC_CONTACT_INBOX_API_URL=
# Score-based reCAPTCHA Enterprise site key зарегистрированного Firebase App Check web app.
# Публичный ключ; consumed limited-use token защищает каждую отправку и retry.
NEXT_PUBLIC_APP_CHECK_SITE_KEY=
# Реальный origin этого сайта для canonical/metadata. Не example domain.
# Hosting Node API и Next.js, deployed Rules/indexes и authorized Auth domain обязательны.
# NEXT_PUBLIC_* фиксируются при npm run build: после изменения требуется пересборка.
NEXT_PUBLIC_WEB_ORIGIN=
# Только для отдельного demo проекта и локальных эмуляторов:
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8085
NEXT_PUBLIC_STORAGE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_STORAGE_EMULATOR_PORT=9199
